--- /dev/null
+++ b/packages/util/http-proxy/src/windows.ts
@@ -0,0 +1,102 @@
+/** Interpret Windows' own proxy decision; this module stores no user routing rules. */
+import { isIP } from 'node:net'
+import { Worker } from 'node:worker_threads'
+import { isLoopbackHost, isSupportedProxyUrl } from './policy.ts'
+import { readWindowsProxySettings, type WindowsProxySettings } from './windows-native.ts'
+
+export interface SystemProxySource {
+  resolve(url: URL, signal?: AbortSignal): Promise<string | undefined>
+  describe(): { source: 'windows'; manualProxy: boolean; autoConfig: boolean; autoDetect: boolean }
+  close(): Promise<void>
+}
+
+/** Windows bypass patterns differ from NO_PROXY: * is a wildcard, and <local> names unqualified hosts.
+ * @param list - native Windows bypass list.
+ * @param url - request destination.
+ * @returns whether Windows' list exempts this destination.
+ */
+export function windowsBypasses(list: string, url: URL): boolean {
+  if (isLoopbackHost(url.hostname)) return true
+  const host = url.hostname.replace(/^\[|\]$/g, '')
+  const port = url.port || (url.protocol === 'https:' ? '443' : '80')
+  for (const item of list.split(/[;\s]+/).filter(Boolean)) {
+    if (item.toLowerCase() === '<local>') { if (!host.includes('.') && !isIP(host)) return true; continue }
+    const pattern = new RegExp('^' + item.replace(/[.+^${}()|[\]\\]/g, '\\$&').replace(/\*/g, '.*').replace(/\?/g, '.') + '$', 'i')
+    if ([host, `${host}:${port}`, url.origin].some(value => pattern.test(value))) return true
+  }
+  return false
+}
+
+/** Choose the first applicable HTTP proxy without retrying a request through other entries.
+ * @param url - request destination.
+ * @param proxyList - proxy list returned by Windows.
+ * @param bypass - accompanying Windows bypass list.
+ * @returns proxy URL, or undefined for a direct decision.
+ */
+export function windowsProxyFor(url: URL, proxyList: string, bypass: string): string | undefined {
+  if (windowsBypasses(bypass, url)) return undefined
+  const candidates = proxyList.split(/[;\s]+/).filter(Boolean)
+  const scheme = url.protocol.slice(0, -1)
+  const specific = candidates.find(value => value.toLowerCase().startsWith(scheme + '='))
+  const selected = specific?.slice(scheme.length + 1) ?? candidates.find(value => !value.includes('='))
+  if (!selected) {
+    if (candidates.some(value => /^socks=/i.test(value))) throw new Error('Windows selected a SOCKS proxy; this DSH HTTP transport does not support it')
+    return undefined
+  }
+  const proxy = selected.includes('://') ? selected : 'http://' + selected
+  if (!isSupportedProxyUrl(proxy)) throw new Error('Windows selected an unsupported proxy scheme; system settings were not bypassed')
+  return proxy
+}
+
+/** Settings are read per request, so closing a proxy application does not leave a pinned port.
+ * @param readSettings - native settings reader; tests supply isolated snapshots without registry writes.
+ * @returns the owned Windows resolver, which must be closed with its transport.
+ */
+export function createWindowsProxySource(readSettings = readWindowsProxySettings): SystemProxySource {
+  let worker: Worker | undefined
+  let nextId = 0
+  let closed = false
+  const pending = new Map<number, { resolve(value: AutoResult): void; reject(error: Error): void }>()
+  type AutoResult = { proxy: string; bypass: string; direct: boolean }
+  function fail(error: Error): void { for (const item of pending.values()) item.reject(error); pending.clear() }
+  function auto(url: URL, settings: WindowsProxySettings, signal?: AbortSignal): Promise<AutoResult> {
+    if (closed) return Promise.reject(new Error('System proxy resolver is closed'))
+    signal?.throwIfAborted()
+    if (!worker) {
+      worker = new Worker(new URL('./windows-worker.js', import.meta.url))
+      worker.on('message', ({ id, result, error }) => {
+        const item = pending.get(id); pending.delete(id)
+        if (error) item?.reject(new Error(error)); else item?.resolve(result)
+        if (!pending.size) worker?.unref()
+      })
+      worker.on('error', fail)
+      worker.on('exit', code => { if (pending.size) fail(new Error(`System proxy worker exited (${code})`)); worker = undefined })
+      worker.unref()
+    }
+    const id = ++nextId
+    return new Promise((resolve, reject) => {
+      const abort = () => { pending.delete(id); if (!pending.size) worker?.unref(); reject(signal!.reason) }
+      const finish = () => signal?.removeEventListener('abort', abort)
+      pending.set(id, { resolve(value) { finish(); resolve(value) }, reject(error) { finish(); reject(error) } })
+      worker!.ref()
+      signal?.addEventListener('abort', abort, { once: true })
+      worker!.postMessage({ id, url: url.href, settings })
+    })
+  }
+  return {
+    async resolve(url, signal) {
+      signal?.throwIfAborted()
+      if (isLoopbackHost(url.hostname)) return undefined
+      const settings = readSettings()
+      if (!settings.autoConfigUrl && !settings.autoDetect) return windowsProxyFor(url, settings.proxy, settings.bypass)
+      const result = await auto(url, settings, signal)
+      signal?.throwIfAborted()
+      return result.direct ? undefined : windowsProxyFor(url, result.proxy, result.bypass)
+    },
+    describe() {
+      const settings = readSettings()
+      return { source: 'windows', manualProxy: Boolean(settings.proxy), autoConfig: Boolean(settings.autoConfigUrl), autoDetect: settings.autoDetect }
+    },
+    async close() { closed = true; fail(new Error('System proxy resolver closed')); if (worker) await worker.terminate() },
+  }
+}

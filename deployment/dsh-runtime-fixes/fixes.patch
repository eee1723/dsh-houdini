@@ -0,0 +1,8 @@
+/** OS PAC evaluation stays off the Host event loop, including GetLastError on the calling thread. */
+import { parentPort } from 'node:worker_threads'
+import { resolveWindowsAutoProxy } from './windows-native.ts'
+
+parentPort!.on('message', ({ id, url, settings }) => {
+  try { parentPort!.postMessage({ id, result: resolveWindowsAutoProxy(url, settings) }) }
+  catch (error) { parentPort!.postMessage({ id, error: error instanceof Error ? error.message : String(error) }) }
+})

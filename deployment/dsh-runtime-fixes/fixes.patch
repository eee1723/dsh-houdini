+/** Native Windows connection settings. No registry writes or proxy configuration of our own. */
+import koffi from 'koffi'
+
+const configType = koffi.struct({ autoDetect: 'int', autoConfigUrl: 'void *', proxy: 'void *', bypass: 'void *' })
+const infoType = koffi.struct({ accessType: 'uint32', proxy: 'void *', bypass: 'void *' })
+const optionsType = koffi.struct({ flags: 'uint32', detectFlags: 'uint32', autoConfigUrl: 'str16', reserved: 'void *', reservedFlags: 'uint32', autoLogon: 'int' })
+const winhttp = koffi.load('winhttp.dll')
+const kernel = koffi.load('kernel32.dll')
+const readConfig = winhttp.func('__stdcall', 'WinHttpGetIEProxyConfigForCurrentUser', 'int', [koffi.out(koffi.pointer(configType))])
+const open = winhttp.func('void * __stdcall WinHttpOpen(str16 agent, uint32 access, str16 proxy, str16 bypass, uint32 flags)')
+const close = winhttp.func('int __stdcall WinHttpCloseHandle(void *handle)')
+const timeouts = winhttp.func('int __stdcall WinHttpSetTimeouts(void *handle, int resolve, int connect, int send, int receive)')
+const resolve = winhttp.func('__stdcall', 'WinHttpGetProxyForUrl', 'int', ['void *', 'str16', koffi.pointer(optionsType), koffi.out(koffi.pointer(infoType))])
+const lastError = kernel.func('uint32 __stdcall GetLastError()')
+const free = kernel.func('void * __stdcall GlobalFree(void *memory)')
+
+type Pointer = unknown
+function text(pointer: Pointer): string {
+  return pointer == null ? '' : koffi.decode(pointer, 'char16_t', -1) as string
+}
+function release(...pointers: Pointer[]): void { for (const pointer of pointers) if (pointer != null) free(pointer) }
+
+export interface WindowsProxySettings {
+  autoDetect: boolean
+  autoConfigUrl: string
+  proxy: string
+  bypass: string
+}
+
+/** Read current-user Windows connection settings and free every OS allocation.
+ * @returns the current settings, with no retained native pointers.
+ */
+export function readWindowsProxySettings(): WindowsProxySettings {
+  const config: Record<string, unknown> = {}
+  if (!readConfig(config)) throw new Error(`Windows proxy settings unavailable (Win32 ${lastError()})`)
+  try {
+    return { autoDetect: Boolean(config.autoDetect), autoConfigUrl: text(config.autoConfigUrl), proxy: text(config.proxy), bypass: text(config.bypass) }
+  } finally { release(config.autoConfigUrl, config.proxy, config.bypass) }
+}
+
+/** Runs only in the owned worker: PAC/WPAD may perform blocking OS network operations.
+ * @param url - full request URL evaluated by Windows.
+ * @param config - settings captured for this request.
+ * @returns Windows' proxy or direct decision; discovery absence uses the configured manual fallback.
+ */
+export function resolveWindowsAutoProxy(url: string, config: WindowsProxySettings): { proxy: string; bypass: string; direct: boolean } {
+  const handle = open('DeepSeek Harness system proxy', 1, null, null, 0)
+  if (handle == null) throw new Error(`Windows proxy session failed (Win32 ${lastError()})`)
+  const info: Record<string, unknown> = {}
+  try {
+    timeouts(handle, 8000, 8000, 8000, 8000)
+    const ok = resolve(handle, url, {
+      flags: config.autoConfigUrl ? 2 : 1,
+      detectFlags: config.autoConfigUrl ? 0 : 3,
+      autoConfigUrl: config.autoConfigUrl || null, reserved: null, reservedFlags: 0, autoLogon: 0,
+    }, info)
+    if (!ok) {
+      const code = lastError()
+      // Automatic discovery finding no PAC is the normal OS fallback to manual settings.
+      if (!config.autoConfigUrl && code === 12180) return { proxy: config.proxy, bypass: config.bypass, direct: !config.proxy }
+      throw new Error(`Windows PAC/WPAD resolution failed (Win32 ${code}); system settings were not bypassed`)
+    }
+    return { proxy: text(info.proxy), bypass: text(info.bypass), direct: info.accessType === 1 }
+  } finally { release(info.proxy, info.bypass); close(handle) }
+}

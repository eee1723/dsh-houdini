<?xml version="1.0" encoding="UTF-8"?>
<!--
  dsh-houdini: add a top-level "DSH-Houdini" menu to Houdini's menu bar.

  Desktop installs the Houdini package for normal use. For development,
  preview the checkout package with houdini/install.py and pass an explicit
  isolated packages directory to register it. Houdini reads the package on
  startup and imports dsh_launcher from the supplied PYTHONPATH.

  The shortcut activates official DSH Desktop and selects this Houdini target.
  It never owns a separate Host or browser window.
-->
<mainMenu>
  <menuBar>
    <subMenu id="dsh_menu">
      <label>DSH-Houdini</label>

      <scriptItem id="dsh.open_workspace">
        <label>Open Workspace</label>
        <scriptCode><![CDATA[
import dsh_launcher
dsh_launcher.open_workspace()
]]></scriptCode>
      </scriptItem>

      <scriptItem id="dsh.version_manager">
        <label>Connection &amp; Support...</label>
        <scriptCode><![CDATA[
import dsh_launcher
dsh_launcher.show_plugin_info()
]]></scriptCode>
      </scriptItem>

    </subMenu>
  </menuBar>
</mainMenu>

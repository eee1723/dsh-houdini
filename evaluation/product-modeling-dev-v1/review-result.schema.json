{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/product-modeling-dev-v1/review-result.schema.json",
  "title": "Manual independent review for one development case",
  "type": "object",
  "additionalProperties": false,
  "required": ["suiteId", "caseId", "reviewer", "run", "evidence", "criteria", "conclusion"],
  "properties": {
    "suiteId": {"const": "product-modeling-dev-v1"},
    "caseId": {"type": "string", "minLength": 1},
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "mode", "reviewedAt"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "mode": {"const": "manual-independent"},
        "reviewedAt": {"type": "string", "format": "date-time"}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["runId", "agentModel", "agentModelVersion", "runtimeIdentity", "wallTimeSeconds", "budgetDescription"],
      "properties": {
        "runId": {"type": "string", "minLength": 1},
        "agentModel": {"type": "string", "minLength": 1},
        "agentModelVersion": {"type": "string", "minLength": 1},
        "runtimeIdentity": {"type": "string", "minLength": 1},
        "wallTimeSeconds": {"type": "number", "minimum": 0},
        "budgetDescription": {"type": "string", "minLength": 1},
        "tokenUsage": {"type": ["object", "null"]},
        "toolCalls": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "origin", "path", "notes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "origin": {"enum": ["agentSubmitted", "reviewerProduced", "source"]},
          "path": {"type": "string", "minLength": 1},
          "notes": {"type": "string"}
        }
      }
    },
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "evidenceIds", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "unverified"]},
          "evidenceIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "conclusion": {
      "type": "object", "additionalProperties": false,
      "required": ["agentClaim", "reviewerJudgement", "summary"],
      "properties": {
        "agentClaim": {"enum": ["complete", "partial", "failed", "unclear"]},
        "reviewerJudgement": {"enum": ["complete", "partial", "failed", "unverified"]},
        "summary": {"type": "string", "minLength": 1}
      }
    }
  }
}

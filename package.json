{
  "name": "dsh-houdini",
  "version": "0.0.2",
  "private": true,
  "description": "DeepSeek Harness plugin that lets the agent control SideFX Houdini",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./executor-host": {
      "types": "./lib/executor-host.d.ts",
      "default": "./lib/executor-host.js"
    },
    "./component-host": {
      "types": "./lib/component-host.d.ts",
      "default": "./lib/component-host.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "shared-host.cordis.yml",
    "dsh-profile.requirements.json",
    "dsh-runtime-compatibility.json",
    "houdini",
    "skills",
    "presets",
    "docs",
    "tools/catalog-lib.mjs",
    "tools/normalized-trace-steps.mjs",
    "tools/trace-session-lib.mjs",
    "tools/hda-delivery-check.py",
    "tools/isolated-houdini-check.py",
    "tools/component-worker.py",
    "tools/prepare-component-profile.mjs",
    "tools/houdini_test_environment.py"
  ],
  "scripts": {
    "build": "npm run docs:generate && node tools/gen-client-catalog.mjs && node tools/gen-trace-client.mjs && node tools/gen-web-polyfills.mjs && node tools/clean-build.mjs && tsc -p tsconfig.json",
    "docs:generate": "node tools/gen-node-card-docs.mjs",
    "docs:check": "node tools/gen-node-card-docs.mjs --check && node tools/tests/docs-contract.test.mjs",
    "test": "npm run build && node tools/run-node-tests.mjs",
    "prepare": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-trajectory"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22",
    "core-js": "3.45.1",
    "esbuild": "0.25.9",
    "typescript": "^5"
  }
}

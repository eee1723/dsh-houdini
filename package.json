{
  "name": "dsh-houdini",
  "version": "0.1.1-rc.2",
  "private": true,
  "description": "DeepSeek Harness plugin that lets the agent control SideFX Houdini",
  "type": "module",
  "main": "lib/frontend-host.js",
  "types": "lib/frontend-host.d.ts",
  "exports": {
    ".": {
      "types": "./lib/frontend-host.d.ts",
      "default": "./lib/frontend-host.js"
    },
    "./client": "./client.js",
    "./agent": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./executor-host": {
      "types": "./lib/executor-host.d.ts",
      "default": "./lib/executor-host.js"
    },
    "./package.json": "./package.json",
    "./icon": "./assets/dsh-houdini-plugin.png",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "client.js",
    "dsh-runtime-compatibility.json",
    "houdini",
    "installer/install.ps1",
    "installer/legacy-migration.ps1",
    "installer/uninstall.ps1",
    "installer/open-desktop.ps1",
    "Install.cmd",
    "Uninstall.cmd",
    "Open Workspace.cmd",
    "locale",
    "assets",
    "skills",
    "presets",
    "docs",
    "tools/catalog-lib.mjs",
    "tools/normalized-trace-steps.mjs",
    "tools/trace-session-lib.mjs",
    "tools/trace-report.mjs",
    "tools/inspect-support-report.py",
    "tools/hda-delivery-check.py",
    "tools/isolated-houdini-check.py",
    "tools/houdini_test_environment.py",
    "tools/isolated-worker.py",
    "runtime/video"
  ],
  "scripts": {
    "build": "npm run docs:generate && node tools/gen-client-catalog.mjs && node tools/gen-trace-client.mjs && node tools/clean-build.mjs && tsc -p tsconfig.json",
    "docs:generate": "node tools/gen-project-layout-docs.mjs && node tools/gen-node-card-docs.mjs && node tools/gen-verb-contract-docs.mjs && node tools/gen-agent-presets.mjs && node tools/gen-tool-docs.mjs",
    "docs:check": "node tools/gen-project-layout-docs.mjs --check && node tools/gen-tool-docs.mjs --check && node tools/gen-node-card-docs.mjs --check && node tools/gen-verb-contract-docs.mjs --check && node tools/gen-agent-presets.mjs --check && node tools/gen-trace-client.mjs --check && node tools/tests/docs-contract.test.mjs",
    "test": "npm run build && node tools/run-node-tests.mjs",
    "prepare": "npm run build",
    "runtime:prepare": "node tools/prepare-dsh-runtime.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./presets/houdini/cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-trajectory",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-win32-process": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent-preset": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.3",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-spill-policy": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-web-app": "0.2.1-rc.3",
    "@deepseek-ai/dsh-win32-process": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22",
    "esbuild": "0.25.9",
    "typescript": "^5",
    "@deepseek-ai/dsh": "0.2.1-rc.3"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "overrides": {
    "zod": "4.4.3"
  },
  "engines": {
    "dsh": "0.2.1-rc.3"
  }
}

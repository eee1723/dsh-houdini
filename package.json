{
  "name": "dsh-houdini",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness plugin that lets the agent control SideFX Houdini",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "dsh-profile.requirements.json",
    "dsh-runtime-compatibility.json",
    "houdini",
    "skills",
    "docs",
    "tools/catalog-lib.mjs",
    "tools/normalized-trace-steps.mjs",
    "tools/trace-session-lib.mjs"
  ],
  "scripts": {
    "build": "node tools/gen-client-catalog.mjs && tsc -p tsconfig.json",
    "test": "npm run build && node tools/run-node-tests.mjs",
    "prepare": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-trajectory"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22",
    "typescript": "^5"
  }
}
